{
  "version": 2,
  "buildCommand": "cd frontend && npm run build:prod",
  "installCommand": "cd frontend && npm ci --legacy-peer-deps",
  "outputDirectory": "frontend/dist/luxelle-landing-page/browser",
  "framework": "angular",
  "nodejs": "22",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ]
}

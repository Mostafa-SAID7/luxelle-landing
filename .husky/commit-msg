#!/bin/sh

# Commit-msg hook for luxelle-landing
# Validates commit messages follow Conventional Commits format

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Extract the first line (subject)
subject=$(echo "$commit_msg" | head -n 1)

# Valid types: feat, fix, docs, style, refactor, perf, test, ci, chore
type_pattern="^(feat|fix|docs|style|refactor|perf|test|ci|chore)(\(.+\))?!?: .{1,50}$"

# Check if subject matches Conventional Commits format
if ! [[ $subject =~ $type_pattern ]]; then
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Your commit message:"
  echo "  $subject"
  echo ""
  echo "Commit messages must follow Conventional Commits format:"
  echo "  <type>(<scope>): <subject>"
  echo ""
  echo "Valid types: feat, fix, docs, style, refactor, perf, test, ci, chore"
  echo "Scope (optional): frontend, backend, auth, payments, ui, performance, deployment"
  echo ""
  echo "Examples:"
  echo "  feat(frontend): add user dashboard page"
  echo "  fix(auth): resolve token expiration issue"
  echo "  docs: update installation instructions"
  echo "  perf(frontend): optimize bundle size"
  echo ""
  exit 1
fi

# Check subject line length (max 50 chars for subject)
if [ ${#subject} -gt 72 ]; then
  echo "⚠️  Warning: Commit subject is very long (${#subject} chars)"
  echo "   Consider keeping it under 50 characters."
fi

echo "✅ Commit message format is valid!"
exit 0

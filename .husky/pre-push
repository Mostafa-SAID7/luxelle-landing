#!/bin/sh

# Pre-push hook for luxelle-landing
# Validates branch names follow the project conventions

protected_branch="main"

# Get the current branch name
current_branch=$(git symbolic-ref --short HEAD)

# Don't allow direct pushes to main
if [ "$current_branch" = "$protected_branch" ]; then
  echo "❌ Pushing directly to '$protected_branch' is not allowed."
  echo "   Please create a Pull Request instead."
  exit 1
fi

# Validate branch name format
# Allowed: feature/*, bugfix/*, release/*, hotfix/*, develop, main
if ! [[ $current_branch =~ ^(feature|bugfix|release|hotfix|develop|main)(/|$) ]]; then
  echo "❌ Invalid branch name: '$current_branch'"
  echo ""
  echo "Branch names must follow one of these patterns:"
  echo "  - feature/<feature-name>     e.g., feature/user-auth"
  echo "  - bugfix/<bug-name>          e.g., bugfix/login-issue"
  echo "  - release/<version>          e.g., release/1.0.0"
  echo "  - hotfix/<issue>             e.g., hotfix/critical-bug"
  echo "  - develop"
  echo "  - main"
  echo ""
  echo "Use lowercase and hyphens instead of spaces."
  exit 1
fi

echo "✅ Branch name is valid: $current_branch"
exit 0
